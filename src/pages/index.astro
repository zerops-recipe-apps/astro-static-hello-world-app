---
// Vite compile-time constants — values are baked in at build time,
// not read at runtime. Defined in astro.config.mjs.
const astroVersion = __ASTRO_VERSION__;
const buildTime = __BUILD_TIME__;

// PUBLIC_APP_ENV is embedded by the Astro/Vite bundler at build time.
// Set it in the build shell: PUBLIC_APP_ENV=production npm run build
// Zerops exposes the 'APP_ENV' service env var as RUNTIME_APP_ENV
// during the build phase, allowing per-environment configuration.
const appEnv = import.meta.env.PUBLIC_APP_ENV ?? 'development';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro · Hello World — Zerops</title>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #13151a;
        color: #cdd6f4;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .card {
        background: #1e2030;
        border: 1px solid #313244;
        border-radius: 16px;
        padding: 3rem 2.5rem;
        width: 100%;
        max-width: 480px;
      }

      .header {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .logo-text {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ff5d01;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 1.875rem;
        font-weight: 700;
        color: #cdd6f4;
        line-height: 1.2;
      }

      .divider {
        border: none;
        border-top: 1px solid #313244;
        margin: 0 0 1.5rem;
      }

      .info-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.875rem 1rem;
        background: #181926;
        border: 1px solid #2a2b3d;
        border-radius: 8px;
      }

      .label {
        font-size: 0.8rem;
        color: #6c7086;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .value {
        font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 0.875rem;
        color: #cdd6f4;
      }

      .env-value {
        background: #1a2f1a;
        color: #a6e3a1;
        padding: 0.2rem 0.65rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-family: 'SF Mono', 'Fira Code', monospace;
      }

      .footer {
        margin-top: 1.75rem;
        text-align: center;
        font-size: 0.8rem;
        color: #45475a;
      }

      .footer a {
        color: #6c7086;
        text-decoration: none;
      }

      .footer a:hover {
        color: #ff5d01;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="header">
        <p class="logo-text">Astro</p>
        <h1>Hello from Zerops!</h1>
      </div>
      <hr class="divider" />
      <div class="info-grid">
        <div class="info-row">
          <span class="label">Framework</span>
          <span class="value">astro@{astroVersion}</span>
        </div>
        <div class="info-row">
          <span class="label">Environment</span>
          <span class="env-value">{appEnv}</span>
        </div>
        <div class="info-row">
          <span class="label">Built at</span>
          <span class="value">{buildTime}</span>
        </div>
      </div>
      <p class="footer">
        Deployed on <a href="https://zerops.io" target="_blank" rel="noopener">Zerops</a>
      </p>
    </div>
  </body>
</html>
